---
import { buildNavTree } from '../../lib/nav-tree';

const roots = await buildNavTree();
const navItems = roots.filter((n) => n.showInNav);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="mobile-nav">
	<input type="checkbox" id="mobile-nav-toggle" class="mobile-nav-checkbox" />
	<label for="mobile-nav-toggle" class="mobile-nav-button" aria-label="Menü öffnen/schließen">
		<span></span>
		<span></span>
		<span></span>
	</label>
	<nav class="mobile-nav-drawer" aria-label="Hauptnavigation (mobil)">
		<ul>
			{
				navItems.map((item) => (
					<li>
						<a href={`${base}/${item.path}/`}>{item.navLabel}</a>
					</li>
				))
			}
		</ul>
	</nav>
</div>

<style>
	.mobile-nav {
		display: block;
	}

	@media (min-width: 640px) {
		.mobile-nav {
			display: none;
		}
	}

	.mobile-nav-checkbox {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.mobile-nav-button {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 2.25rem;
		height: 2.25rem;
		cursor: pointer;
	}

	.mobile-nav-button span {
		display: block;
		height: 2px;
		background: var(--color-brand-blue-dark);
		border-radius: 1px;
	}

	.mobile-nav-drawer {
		display: none;
		position: absolute;
		inset-inline: 0;
		background: var(--color-cream);
		border-bottom: 1px solid var(--color-brand-blue);
		z-index: 20;
	}

	.mobile-nav-drawer ul {
		list-style: none;
		margin: 0;
		padding: 0.5rem 1rem 1rem;
	}

	.mobile-nav-drawer a {
		display: block;
		padding: 0.6rem 0;
		text-decoration: none;
		font-weight: 600;
		color: var(--color-brand-blue-dark);
		border-bottom: 1px solid rgba(62, 96, 148, 0.15);
	}

	/* Pure-CSS "checkbox hack" toggle — no JS needed for the mobile drawer. */
	.mobile-nav-checkbox:checked ~ .mobile-nav-drawer {
		display: block;
	}
</style>
