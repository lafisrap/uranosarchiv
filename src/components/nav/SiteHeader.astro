---
import { Image } from 'astro:assets';
import watercolorSwatch from '../../assets/hero/watercolor-swatch.jpg';
import MainNav from './MainNav.astro';
import MobileNav from './MobileNav.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
	<div class="content-width site-header-inner">
		<a href={`${base}/`} class="brand">
			<Image
				src={watercolorSwatch}
				alt=""
				role="presentation"
				width={72}
				height={72}
				class="brand-swatch"
			/>
			<span class="brand-title">Uranos Archiv</span>
		</a>
		<MainNav />
		<MobileNav />
	</div>
</header>

<style>
	.site-header {
		position: relative;
		border-bottom: 3px solid var(--color-brand-blue);
		background: linear-gradient(
			135deg,
			var(--color-accent-yellow) 0%,
			var(--color-accent-orange) 45%,
			var(--color-brand-blue) 100%
		);
	}

	.site-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.75rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		color: var(--color-ink);
	}

	.brand-swatch {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--color-cream);
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
	}

	.brand-title {
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-ink);
		text-shadow: 0 1px 2px rgba(255, 255, 255, 0.4);
	}

	@media (min-width: 640px) {
		.brand-swatch {
			width: 56px;
			height: 56px;
		}

		.brand-title {
			font-size: 1.6rem;
		}
	}
</style>
