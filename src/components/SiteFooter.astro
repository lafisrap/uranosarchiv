---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="content-width site-footer-inner">
		<p>
			Uranos Archiv — Privates und freies Rudolf-Steiner-Archiv. Nachlässe von Pionieren der
			Anthroposophie.
		</p>
		<p>
			<a href={`${base}/impressum/`}>Impressum</a>
			· © {year}
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 3rem;
		border-top: 1px solid rgba(62, 96, 148, 0.25);
		background: var(--color-cream);
		font-size: 0.85rem;
		color: var(--color-brand-blue-dark);
	}

	.site-footer-inner {
		padding-block: 1.5rem;
	}

	.site-footer p {
		margin: 0.25rem 0;
	}
</style>
