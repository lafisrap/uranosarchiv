---
import type { CollectionEntry } from 'astro:content';
import { r2Url } from '../../lib/r2';

interface Props {
  /** Pages of ONE logical document, already sorted by sequenceIndex. */
  pages: CollectionEntry<'documents'>[];
  title: string;
}

const { pages, title } = Astro.props;

const pageData = pages.map((p) => ({
  sequenceIndex: p.data.sequenceIndex,
  url: r2Url(p.data.r2Key),
}));
---

<div class="document-viewer" data-pages={JSON.stringify(pageData)} data-title={title}>
	<!--
		Always-rendered, no-JS-required fallback: plain download links for every
		page. The script below hides this once the canvas viewer is confirmed
		working (see plans/plan.md, "PDF viewing approach").
	-->
	<ul class="viewer-fallback">
		{
			pageData.map((p) => (
				<li>
					<a href={p.url} target="_blank" rel="noopener">
						Seite {p.sequenceIndex} herunterladen
					</a>
				</li>
			))
		}
	</ul>

	<div class="viewer-canvas-wrap" hidden>
		<div class="viewer-toolbar">
			<button type="button" class="viewer-prev" aria-label="Vorherige Seite">‹</button>
			<span class="viewer-page-indicator">Seite <span class="viewer-current">1</span> von <span class="viewer-total">{pageData.length}</span></span>
			<button type="button" class="viewer-next" aria-label="Nächste Seite">›</button>
			<button type="button" class="viewer-zoom-out" aria-label="Verkleinern">−</button>
			<button type="button" class="viewer-zoom-in" aria-label="Vergrößern">+</button>
			<a class="viewer-original" target="_blank" rel="noopener">Original öffnen</a>
		</div>
		<div class="viewer-canvas-scroll">
			<canvas class="viewer-canvas"></canvas>
		</div>
	</div>
</div>

<style>
	.viewer-fallback {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.viewer-fallback a {
		display: inline-block;
		padding: 0.4rem 0.75rem;
		border: 1px solid var(--color-brand-blue);
		border-radius: 0.35rem;
		text-decoration: none;
	}

	.viewer-canvas-wrap.is-ready {
		display: block;
	}

	.viewer-toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
		font-size: 0.9rem;
	}

	.viewer-toolbar button {
		min-width: 2.25rem;
		min-height: 2.25rem;
		border: 1px solid var(--color-brand-blue);
		background: white;
		border-radius: 0.35rem;
		font-size: 1.1rem;
		cursor: pointer;
	}

	.viewer-toolbar button:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}

	.viewer-original {
		margin-left: auto;
		text-decoration: none;
		font-weight: 600;
	}

	.viewer-canvas-scroll {
		overflow: auto;
		max-height: 80vh;
		border: 1px solid rgba(62, 96, 148, 0.25);
		background: #f4f4f2;
		touch-action: pan-x pan-y pinch-zoom;
	}

	.viewer-canvas {
		display: block;
		margin-inline: auto;
	}
</style>

<script>
	import * as pdfjs from 'pdfjs-dist';

	// The trickiest part of this component — see plans/plan.md, "PDF viewing
	// approach", and src/pages/dev/pdf-test.astro for the isolated
	// proof-of-concept this was validated against first.
	pdfjs.GlobalWorkerOptions.workerSrc = new URL(
		'pdfjs-dist/build/pdf.worker.min.mjs',
		import.meta.url,
	).toString();

	interface PageEntry {
		sequenceIndex: number;
		url: string;
	}

	class UranosDocumentViewer {
		private root: HTMLElement;
		private pages: PageEntry[];
		private currentIndex = 0; // 0-based index into `pages`
		private scale = 1.5;
		private canvas: HTMLCanvasElement;
		private renderToken = 0; // guards against out-of-order async renders

		constructor(root: HTMLElement) {
			this.root = root;
			this.pages = JSON.parse(root.dataset.pages ?? '[]');
			this.canvas = root.querySelector('.viewer-canvas') as HTMLCanvasElement;
		}

		async init() {
			if (this.pages.length === 0) return;

			const wrap = this.root.querySelector<HTMLElement>('.viewer-canvas-wrap')!;
			const prevBtn = this.root.querySelector<HTMLButtonElement>('.viewer-prev')!;
			const nextBtn = this.root.querySelector<HTMLButtonElement>('.viewer-next')!;
			const zoomInBtn = this.root.querySelector<HTMLButtonElement>('.viewer-zoom-in')!;
			const zoomOutBtn = this.root.querySelector<HTMLButtonElement>('.viewer-zoom-out')!;
			const originalLink = this.root.querySelector<HTMLAnchorElement>('.viewer-original')!;

			prevBtn.addEventListener('click', () => this.goTo(this.currentIndex - 1));
			nextBtn.addEventListener('click', () => this.goTo(this.currentIndex + 1));
			zoomInBtn.addEventListener('click', () => this.setScale(this.scale + 0.25));
			zoomOutBtn.addEventListener('click', () => this.setScale(this.scale - 0.25));

			this.attachSwipeHandling(wrap);

			try {
				await this.render(0);
				// Only reveal the canvas viewer — and hide the plain-link
				// fallback — once a page has actually rendered successfully.
				wrap.hidden = false;
				wrap.classList.add('is-ready');
				this.root.querySelector<HTMLElement>('.viewer-fallback')!.hidden = true;
			} catch (err) {
				console.error('DocumentViewer: falling back to plain links —', err);
			}
		}

		private attachSwipeHandling(el: HTMLElement) {
			let startX = 0;
			let startY = 0;
			el.addEventListener(
				'touchstart',
				(e) => {
					startX = e.touches[0].clientX;
					startY = e.touches[0].clientY;
				},
				{ passive: true },
			);
			el.addEventListener(
				'touchend',
				(e) => {
					const dx = e.changedTouches[0].clientX - startX;
					const dy = e.changedTouches[0].clientY - startY;
					// Horizontal swipe, not a vertical scroll gesture.
					if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) {
						this.goTo(this.currentIndex + (dx < 0 ? 1 : -1));
					}
				},
				{ passive: true },
			);
		}

		private setScale(next: number) {
			this.scale = Math.min(3, Math.max(0.5, next));
			this.render(this.currentIndex);
		}

		private goTo(index: number) {
			if (index < 0 || index >= this.pages.length) return;
			this.render(index);
		}

		private async render(index: number) {
			const token = ++this.renderToken;
			const page = this.pages[index];
			const loadingTask = pdfjs.getDocument({ url: page.url });
			const pdf = await loadingTask.promise;
			const pdfPage = await pdf.getPage(1); // each R2 object is a single scanned page
			if (token !== this.renderToken) return; // a newer navigation started meanwhile

			const viewport = pdfPage.getViewport({ scale: this.scale });
			this.canvas.width = viewport.width;
			this.canvas.height = viewport.height;
			const context = this.canvas.getContext('2d')!;
			await pdfPage.render({ canvasContext: context, viewport, canvas: this.canvas }).promise;
			if (token !== this.renderToken) return;

			this.currentIndex = index;
			this.root.querySelector('.viewer-current')!.textContent = String(page.sequenceIndex);
			this.root.querySelector<HTMLButtonElement>('.viewer-prev')!.disabled = index === 0;
			this.root.querySelector<HTMLButtonElement>('.viewer-next')!.disabled =
				index === this.pages.length - 1;
			this.root.querySelector<HTMLAnchorElement>('.viewer-original')!.href = page.url;
		}
	}

	document.querySelectorAll<HTMLElement>('.document-viewer').forEach((root) => {
		new UranosDocumentViewer(root).init();
	});
</script>
