---
interface Props {
  pdfUrl: string;
  pageCount: number;
  title: string;
}

const { pdfUrl, pageCount, title } = Astro.props;
---

<div class="document-viewer" data-pdf-url={pdfUrl} data-page-count={pageCount} data-title={title}>
	<!--
		Always-rendered, no-JS-required fallback: a plain download link. The
		script below hides this once the canvas viewer is confirmed working
		(see plans/plan.md, "PDF viewing approach").
	-->
	<p class="viewer-fallback">
		<a href={pdfUrl} target="_blank" rel="noopener">
			PDF herunterladen{pageCount > 1 ? ` (${pageCount} Seiten)` : ''}
		</a>
	</p>

	<div class="viewer-canvas-wrap" hidden>
		<div class="viewer-toolbar">
			<button type="button" class="viewer-prev" aria-label="Vorherige Seite">‹</button>
			<span class="viewer-page-indicator">Seite <span class="viewer-current">1</span> von <span class="viewer-total">{pageCount}</span></span>
			<button type="button" class="viewer-next" aria-label="Nächste Seite">›</button>
			<button type="button" class="viewer-zoom-out" aria-label="Verkleinern">−</button>
			<button type="button" class="viewer-zoom-in" aria-label="Vergrößern">+</button>
			<a class="viewer-original" href={pdfUrl} target="_blank" rel="noopener">Original öffnen</a>
		</div>
		<div class="viewer-canvas-scroll">
			<canvas class="viewer-canvas"></canvas>
		</div>
	</div>
</div>

<style>
	.viewer-fallback {
		margin: 0;
	}

	.viewer-fallback a {
		display: inline-block;
		padding: 0.4rem 0.75rem;
		border: 1px solid var(--sl-color-accent);
		border-radius: 0.35rem;
		text-decoration: none;
	}

	.viewer-canvas-wrap.is-ready {
		display: block;
	}

	.viewer-toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
		font-size: 0.9rem;
	}

	.viewer-toolbar button {
		min-width: 2.25rem;
		min-height: 2.25rem;
		border: 1px solid var(--sl-color-accent);
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-text);
		border-radius: 0.35rem;
		font-size: 1.1rem;
		cursor: pointer;
	}

	.viewer-toolbar button:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}

	.viewer-original {
		margin-left: auto;
		text-decoration: none;
		font-weight: 600;
	}

	.viewer-canvas-scroll {
		overflow: auto;
		max-height: 80vh;
		border: 1px solid var(--sl-color-hairline);
		/* Deliberately a fixed neutral light gray, not tied to the site's
		   dark/light theme — scanned pages are inherently light paper, and a
		   dark backdrop around them would look like a rendering error rather
		   than a themed choice. */
		background: #f4f4f2;
		touch-action: pan-x pan-y pinch-zoom;
	}

	.viewer-canvas {
		display: block;
		margin-inline: auto;
	}
</style>

<script>
	import * as pdfjs from 'pdfjs-dist';
	import type { PDFDocumentProxy } from 'pdfjs-dist';

	// The trickiest part of this component — see plans/plan.md, "PDF viewing
	// approach", and src/pages/dev/pdf-test.astro (removed after validating
	// this) for the isolated proof-of-concept this was checked against.
	pdfjs.GlobalWorkerOptions.workerSrc = new URL(
		'pdfjs-dist/build/pdf.worker.min.mjs',
		import.meta.url,
	).toString();

	class UranosDocumentViewer {
		private root: HTMLElement;
		private pdfUrl: string;
		private pageCount: number;
		private pdf?: PDFDocumentProxy;
		private currentPage = 1; // 1-based, matches pdf.js's own page numbering
		private scale = 1.5;
		private canvas: HTMLCanvasElement;
		private renderToken = 0; // guards against out-of-order async renders

		constructor(root: HTMLElement) {
			this.root = root;
			this.pdfUrl = root.dataset.pdfUrl ?? '';
			this.pageCount = Number(root.dataset.pageCount ?? '1');
			this.canvas = root.querySelector('.viewer-canvas') as HTMLCanvasElement;
		}

		async init() {
			if (!this.pdfUrl) return;

			const wrap = this.root.querySelector<HTMLElement>('.viewer-canvas-wrap')!;
			const prevBtn = this.root.querySelector<HTMLButtonElement>('.viewer-prev')!;
			const nextBtn = this.root.querySelector<HTMLButtonElement>('.viewer-next')!;
			const zoomInBtn = this.root.querySelector<HTMLButtonElement>('.viewer-zoom-in')!;
			const zoomOutBtn = this.root.querySelector<HTMLButtonElement>('.viewer-zoom-out')!;

			prevBtn.addEventListener('click', () => this.goTo(this.currentPage - 1));
			nextBtn.addEventListener('click', () => this.goTo(this.currentPage + 1));
			zoomInBtn.addEventListener('click', () => this.setScale(this.scale + 0.25));
			zoomOutBtn.addEventListener('click', () => this.setScale(this.scale - 0.25));
			this.attachSwipeHandling(wrap);

			try {
				// Load the PDF document ONCE — page navigation afterwards is just
				// pdf.getPage(n), no repeat network fetches of the whole file.
				this.pdf = await pdfjs.getDocument({ url: this.pdfUrl }).promise;
				await this.render(1);
				wrap.hidden = false;
				wrap.classList.add('is-ready');
				this.root.querySelector<HTMLElement>('.viewer-fallback')!.hidden = true;
			} catch (err) {
				console.error('DocumentViewer: falling back to plain download link —', err);
			}
		}

		private attachSwipeHandling(el: HTMLElement) {
			let startX = 0;
			let startY = 0;
			el.addEventListener(
				'touchstart',
				(e) => {
					startX = e.touches[0].clientX;
					startY = e.touches[0].clientY;
				},
				{ passive: true },
			);
			el.addEventListener(
				'touchend',
				(e) => {
					const dx = e.changedTouches[0].clientX - startX;
					const dy = e.changedTouches[0].clientY - startY;
					// Horizontal swipe, not a vertical scroll gesture.
					if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) {
						this.goTo(this.currentPage + (dx < 0 ? 1 : -1));
					}
				},
				{ passive: true },
			);
		}

		private setScale(next: number) {
			this.scale = Math.min(3, Math.max(0.5, next));
			this.render(this.currentPage);
		}

		private goTo(pageNumber: number) {
			if (pageNumber < 1 || pageNumber > this.pageCount) return;
			this.render(pageNumber);
		}

		private async render(pageNumber: number) {
			if (!this.pdf) return;
			const token = ++this.renderToken;
			const page = await this.pdf.getPage(pageNumber);
			if (token !== this.renderToken) return; // a newer navigation started meanwhile

			const viewport = page.getViewport({ scale: this.scale });
			this.canvas.width = viewport.width;
			this.canvas.height = viewport.height;
			const context = this.canvas.getContext('2d')!;
			await page.render({ canvasContext: context, viewport, canvas: this.canvas }).promise;
			if (token !== this.renderToken) return;

			this.currentPage = pageNumber;
			this.root.querySelector('.viewer-current')!.textContent = String(pageNumber);
			this.root.querySelector<HTMLButtonElement>('.viewer-prev')!.disabled = pageNumber === 1;
			this.root.querySelector<HTMLButtonElement>('.viewer-next')!.disabled = pageNumber === this.pageCount;
		}
	}

	document.querySelectorAll<HTMLElement>('.document-viewer').forEach((root) => {
		new UranosDocumentViewer(root).init();
	});
</script>
