---
import type { LogicalDocument } from '../../lib/documents';
import { findNavNodeBySlug } from '../../lib/nav-tree';

interface Props {
  doc: LogicalDocument;
}

const { doc } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categoryNode = await findNavNodeBySlug(doc.data.category);
const href = `${base}/dokument/${categoryNode?.path}/${doc.data.documentGroup}/`;
const filterText = [doc.data.title, doc.data.date, doc.data.place]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();

function formatDate(iso: string | null, suffix?: string): string {
  if (!iso) return 'undatiert';
  const [year, month, day] = iso.split('-');
  const formatted = `${day}.${month}.${year}`;
  return suffix ? `${formatted}${suffix}` : formatted;
}
---

<a class="document-card" href={href} data-filter-text={filterText}>
	<h3>{doc.data.title}</h3>
	<dl>
		<div>
			<dt>Datum</dt>
			<dd>{formatDate(doc.data.date, doc.data.dateSuffix)}</dd>
		</div>
		{
			doc.data.place && (
				<div>
					<dt>Ort</dt>
					<dd>{doc.data.place}</dd>
				</div>
			)
		}
		<div>
			<dt>Umfang</dt>
			<dd>{doc.data.pageCount} {doc.data.pageCount === 1 ? 'Seite' : 'Seiten'}</dd>
		</div>
	</dl>
	{doc.data.isVerbatim && <span class="badge">Wortlaut</span>}
</a>

<style>
	.document-card {
		display: block;
		position: relative;
		padding: 1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		background: var(--sl-color-bg-nav);
		text-decoration: none;
		color: var(--sl-color-text);
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.document-card:hover {
		border-color: var(--sl-color-accent);
		box-shadow: var(--sl-shadow-sm);
	}

	.document-card h3 {
		margin: 0 0 0.5rem;
		font-size: 1.05rem;
	}

	.document-card dl {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0;
		font-size: 0.85rem;
	}

	.document-card dt {
		font-weight: 600;
		display: inline;
	}

	.document-card dt::after {
		content: ':';
	}

	.document-card dd {
		display: inline;
		margin: 0 0 0 0.25rem;
	}

	.badge {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		background: var(--sl-color-accent);
		color: var(--sl-color-text-invert);
		padding: 0.15rem 0.5rem;
		border-radius: 999px;
	}
</style>
