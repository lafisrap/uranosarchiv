---
import type { LogicalDocument } from '../../lib/documents';
import { findNavNodeBySlug } from '../../lib/nav-tree';

interface Props {
  doc: LogicalDocument;
}

const { doc } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categoryNode = await findNavNodeBySlug(doc.data.category);
const href = `${base}/dokument/${categoryNode?.path}/${doc.data.documentGroup}/`;
const filterText = [doc.data.title, doc.data.date, doc.data.place]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();

function formatDate(iso: string | null, suffix?: string): string {
  if (!iso) return 'undatiert';
  const [year, month, day] = iso.split('-');
  const formatted = `${day}.${month}.${year}`;
  return suffix ? `${formatted}${suffix}` : formatted;
}
---

<a class="document-card" href={href} data-filter-text={filterText}>
	<h3>{doc.data.title}</h3>
	<dl>
		<div>
			<dt>Datum</dt>
			<dd>{formatDate(doc.data.date, doc.data.dateSuffix)}</dd>
		</div>
		{
			doc.data.place && (
				<div>
					<dt>Ort</dt>
					<dd>{doc.data.place}</dd>
				</div>
			)
		}
		<div>
			<dt>Umfang</dt>
			<dd>{doc.data.pageCount} {doc.data.pageCount === 1 ? 'Seite' : 'Seiten'}</dd>
		</div>
	</dl>
	{doc.data.isVerbatim && <span class="badge">Wortlaut</span>}
</a>

<style>
	.document-card {
		display: block;
		position: relative;
		padding: 1.35rem 1.5rem 1.35rem 1.75rem;
		border: 1px solid var(--sl-color-hairline);
		border-left: 3px solid var(--sl-color-accent);
		border-radius: 0.875rem;
		background: var(--sl-color-bg-nav);
		text-decoration: none;
		color: var(--sl-color-text);
		/* Layered shadow — a soft wide one for ambient lift, a tighter one
		   for contact/contour — reads as more "physical" than a single
		   flat shadow. */
		box-shadow:
			0 8px 24px rgba(0, 0, 0, 0.1),
			0 2px 6px rgba(0, 0, 0, 0.06);
		transition:
			box-shadow 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			filter 0.3s ease;
	}

	/*
	 * CategoryFilterBox.astro hides non-matching cards by setting the
	 * `hidden` attribute. The browser's built-in `[hidden] { display: none }`
	 * rule lives in the user-agent stylesheet, which ALWAYS loses to an
	 * author rule of any specificity — so our own `display: block` above
	 * silently defeated it and the filter never actually hid anything.
	 * This author-level `[hidden]` rule has higher specificity than the
	 * bare class rule, so it wins instead.
	 */
	.document-card[hidden] {
		display: none;
	}

	.document-card:hover {
		transform: translateY(-4px);
		filter: brightness(1.03);
		box-shadow:
			0 16px 40px rgba(0, 0, 0, 0.16),
			0 4px 10px rgba(0, 0, 0, 0.08);
	}

	:root[data-theme='dark'] .document-card {
		box-shadow:
			0 8px 24px rgba(0, 0, 0, 0.45),
			0 2px 6px rgba(0, 0, 0, 0.3);
	}

	:root[data-theme='dark'] .document-card:hover {
		box-shadow:
			0 16px 40px rgba(0, 0, 0, 0.6),
			0 4px 10px rgba(0, 0, 0, 0.35);
	}

	.document-card h3 {
		margin: 0 0 0.6rem;
		font-size: 1.3rem;
	}

	.document-card dl {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0;
		padding-top: 0.6rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: 0.85rem;
	}

	/*
	 * Starlight's own .sl-markdown-content CSS adds `margin-top` between any
	 * two adjacent block-level siblings (its generic vertical-rhythm rule,
	 * see node_modules/@astrojs/starlight/style/markdown.css) — these plain
	 * <div> wrappers around each dt/dd pair match that generic selector, so
	 * every row after the first was silently getting pushed down and out of
	 * line with the first row. Reset it explicitly.
	 */
	.document-card dl > div {
		margin: 0;
	}

	.document-card dt {
		font-weight: 600;
		display: inline;
	}

	.document-card dt::after {
		content: ':';
	}

	.document-card dd {
		display: inline;
		margin: 0 0 0 0.25rem;
	}

	.badge {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		background: var(--sl-color-accent);
		color: var(--sl-color-text-invert);
		padding: 0.15rem 0.5rem;
		border-radius: 999px;
	}
</style>
