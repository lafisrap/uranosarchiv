---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { buildNavTree } from '../lib/nav-tree';

const roots = (await buildNavTree()).filter((n) => n.showInNav && n.slug !== 'startseite');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<StarlightPage
	frontmatter={{
		title: 'Willkommen',
		description:
			'Uranos Archiv — privates und freies Rudolf-Steiner-Archiv, Nachlässe von Pionieren der Anthroposophie.',
	}}
>
	<p class="lede">Das Uranos Archiv ist ein privates und freies Rudolf Steiner Archiv.</p>
	<p class="lede">Nachlässe von Pionieren der Anthroposophie finden sich hier wieder.</p>
	<p class="lede">Der Archivzugang wird jedem gewährt.</p>

	<section class="top-categories">
		<h2>Bereiche</h2>
		<div class="category-grid">
			{
				roots.map((node) => (
					<a class="category-tile" href={`${base}/${node.path}/`}>
						<h3>{node.navLabel}</h3>
						{node.children.length > 0 && (
							<p>{node.children.length} Unterkategorien</p>
						)}
					</a>
				))
			}
		</div>
	</section>
</StarlightPage>

<style>
	.lede {
		font-size: 1.05rem;
	}

	.top-categories {
		margin-top: 2rem;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 1rem;
	}

	.category-tile {
		display: block;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		background: var(--sl-color-bg-nav);
		text-decoration: none;
		color: var(--sl-color-text);
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.category-tile:hover {
		border-color: var(--sl-color-accent);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
	}

	.category-tile h3 {
		margin: 0 0 0.25rem;
	}

	.category-tile p {
		margin: 0;
		font-size: 0.85rem;
		color: var(--sl-color-text-accent);
	}
</style>
