---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';

const newsEntries = (await getCollection('news')).sort((a, b) =>
	b.data.date.localeCompare(a.data.date),
);
const news = await Promise.all(
	newsEntries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

function formatDate(iso: string): string {
	const [year, month, day] = iso.split('-');
	return `${day}.${month}.${year}`;
}
---

<StarlightPage
	frontmatter={{
		title: 'Willkommen',
		description:
			'Uranos Archiv — privates und freies Rudolf-Steiner-Archiv, Nachlässe von Pionieren der Anthroposophie.',
	}}
>
	<p class="lede">Das Uranos Archiv ist ein privates und freies Rudolf Steiner Archiv.</p>
	<p class="lede">Nachlässe von Pionieren der Anthroposophie finden sich hier wieder.</p>
	<p class="lede">Der Archivzugang wird jedem gewährt.</p>

	<section class="news">
		<h2>Neuigkeiten</h2>
		{
			news.length > 0 ? (
				<ul class="news-list">
					{news.map(({ entry, Content }) => (
						<li>
							<details>
								<summary>
									<span class="news-date">{formatDate(entry.data.date)}</span>
									<span class="news-title">{entry.data.title}</span>
									<span class="news-teaser">{entry.data.teaser}</span>
								</summary>
								<div class="news-body">
									<Content />
								</div>
							</details>
						</li>
					))}
				</ul>
			) : (
				<p class="news-empty">Aktuell keine Neuigkeiten.</p>
			)
		}
	</section>
</StarlightPage>

<style>
	.lede {
		font-size: 1.3rem;
		line-height: 30.9px;
	}

	.news {
		margin-top: 2rem;
	}

	.news-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.news-list details {
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		background: var(--sl-color-bg-nav);
		padding: 1rem 1.25rem;
	}

	.news-list summary {
		cursor: pointer;
		list-style: none;
	}

	.news-list summary::-webkit-details-marker {
		display: none;
	}

	.news-date {
		display: block;
		font-size: 0.85rem;
		color: var(--sl-color-text-accent);
	}

	.news-title {
		display: block;
		font-size: 1.2rem;
		margin: 0.15rem 0 0.35rem;
	}

	.news-teaser {
		display: block;
		color: var(--sl-color-text-accent);
	}

	.news-list details[open] .news-teaser {
		display: none;
	}

	.news-body {
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-hairline);
	}

	.news-empty {
		font-style: italic;
		color: var(--sl-color-text-accent);
	}
</style>
