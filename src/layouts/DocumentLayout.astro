---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/nav/Breadcrumbs.astro';
import DocumentViewer from '../components/document/DocumentViewer.astro';
import { r2Url } from '../lib/r2';
import type { NavNode } from '../lib/nav-tree';
import type { LogicalDocument } from '../lib/documents';

interface Props {
  trail: NavNode[];
  doc: LogicalDocument;
}

const { trail, doc } = Astro.props;

function formatDate(iso: string | null, suffix?: string): string {
  if (!iso) return 'undatiert';
  const [year, month, day] = iso.split('-');
  const formatted = `${day}.${month}.${year}`;
  return suffix ? `${formatted}${suffix}` : formatted;
}
---

<BaseLayout title={doc.data.title}>
	<Breadcrumbs trail={trail} current={doc.data.title} />
	<h1>{doc.data.title}</h1>

	<dl class="document-meta">
		<div>
			<dt>Datum</dt>
			<dd>{formatDate(doc.data.date, doc.data.dateSuffix)}</dd>
		</div>
		{
			doc.data.place && (
				<div>
					<dt>Ort</dt>
					<dd>{doc.data.place}</dd>
				</div>
			)
		}
		<div>
			<dt>Umfang</dt>
			<dd>{doc.data.pageCount} {doc.data.pageCount === 1 ? 'Seite' : 'Seiten'}</dd>
		</div>
		{
			doc.data.isVerbatim && (
				<div>
					<dt>Hinweis</dt>
					<dd>Wortlaut-Transkription</dd>
				</div>
			)
		}
	</dl>

	<DocumentViewer pdfUrl={r2Url(doc.data.r2Key)} pageCount={doc.data.pageCount} title={doc.data.title} />
</BaseLayout>

<style>
	.document-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin: 1rem 0 1.5rem;
		font-size: 0.9rem;
	}

	.document-meta dt {
		font-weight: 600;
		display: inline;
	}

	.document-meta dt::after {
		content: ':';
	}

	.document-meta dd {
		display: inline;
		margin: 0 0 0 0.3rem;
	}
</style>
