---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Breadcrumbs from '../components/nav/Breadcrumbs.astro';
import DocumentCard from '../components/document/DocumentCard.astro';
import CategoryFilterBox from '../components/CategoryFilterBox.astro';
import type { NavNode } from '../lib/nav-tree';
import type { LogicalDocument } from '../lib/documents';

interface Props {
  node: NavNode;
  trail: NavNode[];
  documents: LogicalDocument[];
}

const { node, trail, documents } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<StarlightPage frontmatter={{ title: node.title }}>
	<Breadcrumbs trail={trail} />

	{
		node.children.length > 0 && (
			<section class="subcategories">
				<h2>Unterkategorien</h2>
				<ul>
					{node.children.map((child) => (
						<li>
							<a href={`${base}/${child.path}/`}>{child.navLabel}</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		documents.length > 0 ? (
			<section class="documents">
				<h2>Dokumente ({documents.length})</h2>
				<CategoryFilterBox targetSelector="#document-grid" />
				<div id="document-grid" class="document-grid">
					{documents.map((doc) => (
						<DocumentCard doc={doc} />
					))}
				</div>
			</section>
		) : (
			node.children.length === 0 && (
				<p class="empty-notice">
					Für diese Kategorie sind noch keine Dokumente migriert. (Phase 2 der{' '}
					<a href="https://github.com/lafisrap/uranosarchiv/blob/main/plans/plan.md">
						Rebuild-Planung
					</a>
					.)
				</p>
			)
		)
	}
</StarlightPage>

<style>
	.subcategories ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0 0 2rem;
		padding: 0;
	}

	.subcategories a {
		display: inline-block;
		padding: 0.5rem 1rem;
		border: 1px solid var(--sl-color-accent);
		border-radius: 999px;
		text-decoration: none;
		font-weight: 600;
	}

	.document-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1rem;
	}

	.empty-notice {
		font-style: italic;
		color: var(--sl-color-text-accent);
	}
</style>
